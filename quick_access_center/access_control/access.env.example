# Run python access_control/setup_access.py to create access.env (do not commit it).
MAIN_ACCESS_ENABLED=1
MAIN_ACCESS_USERNAME=admin
MAIN_ACCESS_PASSWORD_HASH=
MAIN_ACCESS_SECRET_KEY=
MAIN_ACCESS_ALLOWED_IPS=127.0.0.1,::1
MAIN_ACCESS_TRUST_PROXY=0
# Set TRUST_PROXY=1 only behind a trusted reverse proxy which overwrites/appends X-Forwarded-For.
MAIN_ACCESS_TRUSTED_PROXIES=127.0.0.1,::1
MAIN_ACCESS_SESSION_HOURS=12
MAIN_ACCESS_LOG_FAILED=1
MAIN_ACCESS_MAX_FAILED_ATTEMPTS=5
MAIN_ACCESS_FAILED_WINDOW_MINUTES=10
MAIN_ACCESS_LOCK_MINUTES=15
MAIN_ACCESS_FAILED_DELAY_SECONDS=1
