# Run python vault_control/setup_vault.py to create vault.env (do not commit it).
# Keep a private backup of vault.env: the encryption key is needed to read existing records.
VAULT_ACCESS_ENABLED=1
VAULT_ACCESS_USERNAME=vault-admin
VAULT_ACCESS_PASSWORD_HASH=
VAULT_ENCRYPTION_KEY=
VAULT_ACCESS_ALLOWED_IPS=127.0.0.1,::1
VAULT_ACCESS_TRUST_PROXY=0
VAULT_ACCESS_TRUSTED_PROXIES=127.0.0.1,::1
VAULT_ACCESS_SESSION_MINUTES=30
VAULT_ACCESS_SLIDING_SESSION=1
VAULT_ACCESS_SESSION_REFRESH_SECONDS=30
VAULT_ACCESS_MAX_FAILED_ATTEMPTS=5
VAULT_ACCESS_FAILED_WINDOW_MINUTES=10
VAULT_ACCESS_LOCK_MINUTES=15
VAULT_ACCESS_FAILED_DELAY_SECONDS=1
# Точные адреса страниц входа для автовхода через расширение (через запятую).
# Встроенные адреса перечислены в vault_control/autologin.py; сюда добавляйте остальные.
# Без *, параметров и якорей; те же адреса нужны в browser_extension/sites.local.json.
# См. browser_extension/ADDING_SERVICES.md
VAULT_AUTOLOGIN_SITES=
# 1 = разрешить http:// для частных адресов (192.168.x.x, 10.x.x.x, 172.16-31.x.x, 127.x.x.x, localhost).
# Нужен для встроенного внутреннего сервиса http://192.168.8.81:8085/login.
# Пароль при этом идёт по сети открытым текстом — лучше поставить сервису TLS.
VAULT_AUTOLOGIN_ALLOW_PRIVATE_HTTP=0
